{
  "name": "crystara_indexer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx server.ts",
    "lint": "next lint",
    "dev:indexer": "tsx watch scripts/run-indexer.ts",
    "indexer": "tsx scripts/run-indexer.ts",
    "prisma:generate:supabase": "prisma generate --schema=./prisma/supabase/schema.prisma",
    "prisma:generate:sqlite": "prisma generate --schema=./prisma/sqlite/schema.prisma",
    "prisma:migrate:supabase": "prisma migrate dev --schema=./prisma/supabase/schema.prisma --create-only",
    "prisma:migrate:sqlite": "prisma migrate dev --schema=./prisma/sqlite/schema.prisma",
    "pm2:start": "npx pm2 start ecosystem.config.js",
    "pm2:stop": "npx pm2 stop ecosystem.config.js",
    "pm2:restart": "npx pm2 restart ecosystem.config.js",
    "pm2:logs": "npx pm2 logs"
  },
  "dependencies": {
    "@pm2/io": "6.1.0",
    "@prisma/client": "6.2.1",
    "dotenv": "16.4.7",
    "next": "15.1.6",
    "node-cron": "4.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "5.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.0.0",
    "@types/node": "20.10.0",
    "@types/node-cache": "4.1.3",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "9.0.0",
    "eslint-config-next": "15.1.4",
    "pm2": "6.0.14",
    "postcss": "8.5.10",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.1",
    "tsx": "4.21.0",
    "typescript": "5.3.3"
  }
}
